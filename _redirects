# مسارات مع معاملات (Query Parameters)
/surah/:n    /surah.html?n=:n    200
/mushaf/page/:page    /mushaf.html?page=:page    200
/listen/surah/:n    /listen.html?n=:n    200

# الملفات الثابتة (CSS, JS, images, manifest)
/assets/*    /assets/:splat    200
/css/*    /css/:splat    200
/js/*    /js/:splat    200
/data/*    /data/:splat    200
/manifest.json    /manifest.json    200
/service-worker.js    /service-worker.js    200

