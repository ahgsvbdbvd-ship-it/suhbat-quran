/    /index.html    200
/quran    /Quran.html    200
/mushaf    /mushaf.html    200
/azkar    /azkar.html    200
/tasbeeh    /tasbeeh.html    200
/family    /family.html    200
/settings    /settings.html    200
/stats    /stats.html    200
/favorites    /favorites.html    200
/listen    /listen.html    200
/salah    /salah.html    200
